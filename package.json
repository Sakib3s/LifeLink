{
  "name": "lifelink-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind + asset pipeline for LifeLink",
  "scripts": {
    "build:css": "tailwindcss --config ./resources/tailwind.config.js -i ./resources/tailwind/input.css -o ./public/assets/css/app.css --minify && node ./scripts/copy-vendor-assets.mjs",
    "watch:css": "tailwindcss --config ./resources/tailwind.config.js -i ./resources/tailwind/input.css -o ./public/assets/css/app.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@tabler/icons-webfont": "^3.24.0",
    "autoprefixer": "^10.4.20",
    "jquery": "^3.7.1",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.17"
  }
}
