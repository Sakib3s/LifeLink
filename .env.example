# ─────────────────────────────────────────────────────────────
# LifeLink environment configuration
# Copy this file to .env and adjust for your environment.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

APP_NAME="LifeLink"
APP_ENV=local            # local | production
APP_DEBUG=true           # true shows detailed errors; set false in production
APP_URL=https://blood-bank.ddev.site
# APP_URL may include a subpath if the app is not deployed at the domain
# root — every link, redirect and asset URL adapts automatically. Example
# for a shared-hosting deployment under a subfolder:
#   APP_URL=https://example.com/rtm/lifelink
APP_TIMEZONE=UTC

# Database (defaults below match the bundled DDEV setup: `ddev describe`)
DB_HOST=db
DB_PORT=3306
DB_NAME=db
DB_USER=db
DB_PASSWORD=db
DB_CHARSET=utf8mb4

# Session
SESSION_NAME=lifelink_session
SESSION_LIFETIME=7200     # seconds

# Matching engine defaults (also editable at runtime via Admin → System Settings)
MATCH_DEFAULT_RADIUS_KM=25
MATCH_MAX_DONORS_PER_REQUEST=25

# Simple brute-force protection
RATE_LIMIT_LOGIN_MAX=5          # attempts
RATE_LIMIT_LOGIN_WINDOW=300     # seconds

# WhatsApp donor alerts (Meta WhatsApp Cloud API).
# Leave WHATSAPP_ENABLED=false (or the token blank) for local/dev work:
# messages are logged instead of sent, so no account is needed to develop.
# Get these from business.facebook.com > WhatsApp > API Setup once you have
# a Meta Business + WhatsApp Business phone number.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=lifelink_alert
WHATSAPP_TEMPLATE_LANG=en
