# ─────────────────────────────────────────────────────────────
# LifeLink environment configuration
# Copy this file to .env and adjust for your environment.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

APP_NAME="LifeLink"
APP_ENV=local            # local | production
APP_DEBUG=true           # true shows detailed errors; set false in production
APP_URL=https://blood-bank.ddev.site
APP_TIMEZONE=UTC

# Database (defaults below match the bundled DDEV setup: `ddev describe`)
DB_HOST=db
DB_PORT=3306
DB_NAME=db
DB_USER=db
DB_PASSWORD=db
DB_CHARSET=utf8mb4

# Session
SESSION_NAME=lifelink_session
SESSION_LIFETIME=7200     # seconds

# Matching engine defaults (also editable at runtime via Admin → System Settings)
MATCH_DEFAULT_RADIUS_KM=25
MATCH_MAX_DONORS_PER_REQUEST=25

# Simple brute-force protection
RATE_LIMIT_LOGIN_MAX=5          # attempts
RATE_LIMIT_LOGIN_WINDOW=300     # seconds
